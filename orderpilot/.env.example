# Copiez ce fichier en ".env" et remplissez les valeurs. Ne publiez JAMAIS le fichier .env.

# Port du serveur local
PORT=3000

# "development" en local, "production" une fois en ligne (active les cookies sécurisés)
NODE_ENV=development

# Nom de la marque (provisoire). Changer ici suffit à renommer l'interface.
BRAND_NAME=OrderPilot

# Emplacement du fichier de base de données SQLite
DATABASE_PATH=./data/orderpilot.db

# --- Intelligence artificielle ---
# "demo" = fournisseur gratuit sans IA réelle (règles simples), "anthropic" = Claude.
# Si vide : "anthropic" si une clé est présente, sinon "demo".
AI_PROVIDER=
# Clé API Anthropic (payante, à l'usage). Ne pas remplir sans autorisation budgétaire.
ANTHROPIC_API_KEY=
# Modèle Claude. Voir docs/02-produit-et-architecture.md pour la comparaison des coûts.
AI_MODEL=claude-opus-5-5

# Mettre à 1 si le serveur est derrière un proxy (hébergeur), pour lire la vraie adresse IP
TRUST_PROXY=0
